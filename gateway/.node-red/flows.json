[
    {
        "id": "iot-env-monitor-tab",
        "type": "tab",
        "label": "IoT Env Monitor",
        "disabled": false,
        "info": "ESP32 Environmental Monitoring Gateway"
    },
    {
        "id": "sim-inject",
        "type": "inject",
        "z": "iot-env-monitor-tab",
        "name": "Simulate ESP32 (disabled)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "5",
        "topic": "",
        "payload": "{\"device_id\":\"esp32-001\",\"co2_ppm\":487,\"temperature_c\":22.3,\"humidity_pct\":48.1,\"pressure_hpa\":1013.2,\"light_lux\":342,\"sound_level_adc\":1850,\"sound_peak_adc\":2100,\"sound_rms_adc\":1780,\"sound_event\":false,\"battery_v\":3.92}",
        "payloadType": "str",
        "x": 210,
        "y": 160,
        "wires": []
    },
    {
        "id": "serial-in-com3",
        "type": "serial in",
        "z": "iot-env-monitor-tab",
        "name": "ESP32 USB serial COM3",
        "serial": "serial-com3",
        "x": 210,
        "y": 120,
        "wires": [
            [
                "filter-json-lines"
            ]
        ]
    },
    {
        "id": "filter-json-lines",
        "type": "function",
        "z": "iot-env-monitor-tab",
        "name": "Keep JSON lines only",
        "func": "var line = String(msg.payload || \"\").trim();\nif (!line.startsWith(\"{\") || !line.endsWith(\"}\")) {\n    return null;\n}\nmsg.payload = line;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 120,
        "wires": [
            [
                "parse-json"
            ]
        ]
    },
    {
        "id": "parse-json",
        "type": "json",
        "z": "iot-env-monitor-tab",
        "name": "Parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 650,
        "y": 160,
        "wires": [
            [
                "validate-fn"
            ]
        ]
    },
    {
        "id": "validate-fn",
        "type": "function",
        "z": "iot-env-monitor-tab",
        "name": "Validate & Enrich",
        "func": "var d = msg.payload;\nvar required = [\"device_id\",\"co2_ppm\",\"temperature_c\",\"humidity_pct\",\"pressure_hpa\",\"light_lux\",\"sound_level_adc\"];\nvar missing = required.filter(function(k){ return d[k] === undefined; });\nif (missing.length > 0) { node.warn(\"Missing: \" + missing.join(\", \")); return null; }\nif (d.co2_ppm < 0 || d.co2_ppm > 5000) { node.warn(\"CO2 out of range\"); return null; }\nif (d.temperature_c < -40 || d.temperature_c > 85) { node.warn(\"Temp out of range\"); return null; }\nif (d.humidity_pct < 0 || d.humidity_pct > 100) { node.warn(\"Humidity out of range\"); return null; }\nd.timestamp = new Date().toISOString();\nd.gateway_id = \"node-red-gw-01\";\nd.source = \"uart\";\nif (d.sound_peak_adc === undefined) d.sound_peak_adc = d.sound_level_adc;\nif (d.sound_rms_adc === undefined) d.sound_rms_adc = d.sound_level_adc;\nif (d.sound_event === undefined) d.sound_event = false;\nmsg.payload = d;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 160,
        "wires": [
            [
                "debug-raw",
                "buffer-fn"
            ]
        ]
    },
    {
        "id": "debug-raw",
        "type": "debug",
        "z": "iot-env-monitor-tab",
        "name": "Debug: reading",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload.device_id",
        "statusType": "auto",
        "x": 870,
        "y": 100,
        "wires": []
    },
    {
        "id": "buffer-fn",
        "type": "function",
        "z": "iot-env-monitor-tab",
        "name": "Forward each reading",
        "func": "if (flow.get(\"monitoringEnabled\") === false && msg.payload.device_id === \"esp32-001\") {\n    node.status({fill:\"yellow\",shape:\"ring\",text:\"paused - not forwarding\"});\n    return null;\n}\nvar seq = (flow.get(\"seq\") || 0) + 1;\nflow.set(\"seq\", seq);\nmsg.payload = { gateway_id: \"node-red-gw-01\", sent_at: new Date().toISOString(), sequence: seq, readings: [msg.payload] };\nnode.status({fill:\"green\",shape:\"dot\",text:\"sent reading (seq \"+seq+\")\"});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "flow.set(\"seq\",0);\nif (flow.get(\"monitoringEnabled\") === undefined) flow.set(\"monitoringEnabled\", true);",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 200,
        "wires": [
            [
                "http-post",
                "debug-batch"
            ]
        ]
    },
    {
        "id": "debug-batch",
        "type": "debug",
        "z": "iot-env-monitor-tab",
        "name": "Debug: batch",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 1110,
        "y": 260,
        "wires": []
    },
    {
        "id": "http-post",
        "type": "http request",
        "z": "iot-env-monitor-tab",
        "name": "POST to Backend",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://team2.up.railway.app/api/readings/ingest",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": true,
        "headers": [
            {
                "keyType": "other",
                "keyValue": "x-gateway-key",
                "valueType": "other",
                "valueValue": "gw-secret-key-change-me"
            }
        ],
        "x": 1110,
        "y": 200,
        "wires": [
            [
                "response-check"
            ]
        ]
    },
    {
        "id": "response-check",
        "type": "function",
        "z": "iot-env-monitor-tab",
        "name": "Check Response",
        "func": "if (msg.statusCode === 200 || msg.statusCode === 201) {\n    node.status({fill:\"green\",shape:\"dot\",text:\"OK \"+msg.statusCode});\n} else {\n    node.warn(\"Backend error: \"+msg.statusCode);\n    node.status({fill:\"red\",shape:\"ring\",text:\"ERR \"+msg.statusCode});\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1320,
        "y": 200,
        "wires": [
            [
                "debug-resp"
            ]
        ]
    },
    {
        "id": "debug-resp",
        "type": "debug",
        "z": "iot-env-monitor-tab",
        "name": "Debug: response",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "x": 1530,
        "y": 200,
        "wires": []
    },
    {
        "id": "comment-arch",
        "type": "comment",
        "z": "iot-env-monitor-tab",
        "name": "ESP32 --UART--> Node-RED --HTTP POST--> Express.js",
        "info": "1. ESP32 sends JSON via UART every 5s\n2. Parse, validate, enrich with timestamp\n3. POST each validated reading immediately\n4. Backend stores it as GatewayIngestPayload",
        "x": 290,
        "y": 40,
        "wires": []
    },
    {
        "id": "serial-note",
        "type": "comment",
        "z": "iot-env-monitor-tab",
        "name": "Real input: COM3 serial-in is active",
        "info": "The Simulate ESP32 inject node is disabled. Real ESP32 JSON lines are read from COM3 at 115200 baud through node-red-node-serialport.",
        "x": 370,
        "y": 240,
        "wires": []
    },
    {
        "id": "control-poll",
        "type": "inject",
        "z": "iot-env-monitor-tab",
        "name": "Poll backend monitoring control",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "3",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 250,
        "y": 340,
        "wires": [
            [
                "control-http"
            ]
        ]
    },
    {
        "id": "control-http",
        "type": "http request",
        "z": "iot-env-monitor-tab",
        "name": "GET monitoring control",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://team2.up.railway.app/api/devices/esp32-001/monitoring-control",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": true,
        "headers": [
            {
                "keyType": "other",
                "keyValue": "x-gateway-key",
                "valueType": "other",
                "valueValue": "gw-secret-key-change-me"
            }
        ],
        "x": 530,
        "y": 340,
        "wires": [
            [
                "control-apply"
            ]
        ]
    },
    {
        "id": "control-apply",
        "type": "function",
        "z": "iot-env-monitor-tab",
        "name": "Apply monitoring control",
        "func": "if (msg.statusCode !== 200) {\n    node.warn(\"Control endpoint error: \" + msg.statusCode);\n    node.status({fill:\"red\",shape:\"ring\",text:\"control err \" + msg.statusCode});\n    return null;\n}\nvar control = msg.payload || {};\nvar enabled = control.monitoring_enabled !== false;\nvar seq = Number(control.command_seq || 0);\nvar lastSeq = flow.get(\"monitoringCommandSeq\");\nvar current = flow.get(\"monitoringEnabled\");\nif (lastSeq === seq && current === enabled) {\n    return null;\n}\nflow.set(\"monitoringCommandSeq\", seq);\nflow.set(\"monitoringEnabled\", enabled);\nmsg.payload = \"TEAM2APP:\" + (enabled ? \"RESUME\" : \"PAUSE\") + \"\\n\";\nnode.status({fill:enabled ? \"green\" : \"yellow\",shape:enabled ? \"dot\" : \"ring\",text:enabled ? \"resume sent\" : \"pause sent\"});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "if (flow.get(\"monitoringEnabled\") === undefined) flow.set(\"monitoringEnabled\", true);",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 340,
        "wires": [
            [
                "serial-out-com3",
                "debug-control"
            ]
        ]
    },
    {
        "id": "serial-out-com3",
        "type": "serial out",
        "z": "iot-env-monitor-tab",
        "name": "ESP32 control serial out",
        "serial": "serial-com3",
        "x": 1060,
        "y": 320,
        "wires": []
    },
    {
        "id": "debug-control",
        "type": "debug",
        "z": "iot-env-monitor-tab",
        "name": "Debug: control command",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 1080,
        "y": 380,
