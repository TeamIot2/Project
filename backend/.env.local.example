GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Must exactly match one authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/api/auth/google/callback

# Frontend origins that may receive the login result.
FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

# SMTP account used for real Team2App email notifications.
# Works with any provider that exposes SMTP, including free-tier services.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Team2App <notifications@example.com>"

# Optional: prevents repeated email notifications for the same sensor state.
EMAIL_NOTIFICATION_COOLDOWN_MS=1800000

# Production database. When this is set, the backend uses PostgreSQL instead of
# the local sql.js SQLite file at backend/data/readings.db.
# On Railway, add a PostgreSQL service and reference its DATABASE_URL variable.
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional local fallback path when DATABASE_URL is not set.
# READINGS_DB_PATH=backend/data/readings.db

# Optional one-time migration from the currently deployed Railway API into a
# fresh Railway PostgreSQL database before the app service is switched over.
# SOURCE_API_BASE=https://team2.up.railway.app/api
# SOURCE_ADMIN_EMAIL=admin@email.com
# SOURCE_ADMIN_PASSWORD=admin
# SOURCE_FROM=2020-01-01T00:00:00.000Z
# SOURCE_TO=2026-06-06T23:59:59.999Z
# MIGRATION_WINDOW_DAYS=30
